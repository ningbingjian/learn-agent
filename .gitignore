# Jupyter
.ipynb_checkpoints/

# ==============================
# Java / Kotlin / JVM
# ==============================
*.class
target/
.gradle/
.kotlin/
.mvn/timing.properties
*.war
*.ear
*.nar
# JARs can be checked-in dependencies or wrappers; ignore generated ones
# via build/ and target/ rather than ignoring every *.jar.

# JVM crash reports
hs_err_pid*
replay_pid*

# Maven temporary/release files
dependency-reduced-pom.xml
release.properties
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.tag
pom.xml.next
pom.xml.bak
.flattened-pom.xml

# Keep Maven/Gradle wrappers and their JAR files in Git.

# ==============================
# Node.js / TypeScript
# Vue / React / Vite / Next / Nuxt
# ==============================
node_modules/
.npm/
.pnpm-store/
.pnpm-debug.log*
.yarn-integrity
.node_repl_history
.pnp.*

