# ==============================
# Shared ignore rules for Java, Python, Vue, React, Go, Rust, and more.
# Rules apply to nested projects unless explicitly rooted with '/'.
# Keep dependency lockfiles, source code, migrations, and build wrappers.
# Avoid broad rules such as *.lock, *.json, *.yaml, bin/, or vendor/.
# Ignoring a path does not untrack files already committed to Git.
#
# Operating systems
# ==============================
.DS_Store
._*
Thumbs.db
Desktop.ini
.AppleDouble
.LSOverride
.Spotlight-V100/
.Trashes/
.fseventsd/
ehthumbs.db
Thumbs.db:encryptable
$RECYCLE.BIN/
*.stackdump

# ==============================
# Editors and IDEs
# ==============================
.idea/
*.iml
*.ipr
*.iws
out/

.vscode/
*.swp
*.swo
*~
.fleet/
.history/
.settings/
.classpath
.project
.factorypath
.metadata/
*.sublime-workspace
*.swn
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# ==============================
# Environment variables / secrets
# Commit example files, not real credentials.
# ==============================
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
!.env.template
!.env.*.template
.secrets/
.envrc.local
.direnv/
*.key
*.p12
*.pfx
*.jks
*.keystore
# Public certificates (*.crt, *.cer, *.pem) may be legitimate source assets.
# Add exact paths for any private keys stored in PEM files.

# ==============================
# Logs and temporary files
# ==============================
*.log
logs/
*.tmp
*.temp
.cache/
tmp/
temp/
*.pid
*.pid.lock
*.seed
*.orig
*.rej
*.bak
*.hprof

