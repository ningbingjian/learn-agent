.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

*.tsbuildinfo
.eslintcache
.stylelintcache

# Build and framework output
.vite/
.next/
.nuxt/
.output/
.svelte-kit/
.parcel-cache/
.turbo/
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.sass-cache/
.temp/
.docusaurus/
.astro/
.angular/cache/
.nx/cache/
.nx/workspace-data/
storybook-static/
web-dist/
.vercel/
.netlify/
.wrangler/
.serverless/
.aws-sam/

# Test output
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
playwright/.cache/
cypress/screenshots/
cypress/videos/
.vitest/

# Local development overrides
*.local

# Package-manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==============================
# Go
# Keep go.mod, go.sum, and intentionally vendored source.
# ==============================
*.test
*.test.exe
*.prof
*.pprof
coverage.out
coverage.txt
profile.out
go.work
go.work.sum
# go.work is local by default; remove these two rules for shared workspaces.
.gocache/
.gomodcache/
# Add exact binary output paths per project; bin/ may contain source scripts.

# ==============================
# Rust
# target/ is shared with Maven above; keep Cargo.lock for reproducible builds.
# ==============================
**/target/
**/*.rs.bk
*.rlib
*.rmeta
*.profraw
*.profdata
tarpaulin-report.html

# ==============================
# Native build products / C / C++ / Swift
# ==============================
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.dSYM/
CMakeFiles/
CMakeCache.txt
cmake-build-*/
compile_commands.json
CTestTestfile.cmake
cmake_install.cmake
install_manifest.txt
.ninja_deps
.ninja_log
.build/
DerivedData/
xcuserdata/
*.xcuserstate

# ==============================
# Other common language tooling
# ==============================
# .NET: avoid bin/ because other projects may keep scripts there.
obj/
TestResults/
# PHP: vendor/ remains trackable for projects that intentionally vendor code.
.phpunit.cache/
.phpunit.result.cache
# Ruby / Bundler
.bundle/
vendor/bundle/
.byebug_history
# Dart / Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
# Elixir / Erlang
_build/
erl_crash.dump
.elixir_ls/

# ==============================
# Infrastructure / local runtime state
# Keep Dockerfiles, compose files, infrastructure code, and examples.
# ==============================
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
.vagrant/
.local/share/

# ==============================
# Local AI / ML caches and experiment output
# Keep model/data files trackable unless a project explicitly ignores them.
# ==============================
.ipython/
.jupyter/lab/workspaces/
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v*/
wandb/
mlruns/
mlartifacts/

