.eggs/
pip-wheel-metadata/
*.egg
__pypackages__/
.Python
pip-log.txt
pip-delete-this-directory.txt
.pdm-python
.pdm-build/
.uv-cache/
.pybuilder/
.dmypy.json
dmypy.json
nosetests.xml
pytestdebug.log
